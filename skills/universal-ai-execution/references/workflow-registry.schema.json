{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:universal-ai-execution:workflow-registry.schema.json",
  "title": "Universal AI Execution Workflow Registry",
  "type": "object",
  "required": [
    "version",
    "registry_name",
    "workflow_count",
    "default_workflow_sequence",
    "focused_skill_mappings",
    "workflows"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "registry_name": {
      "type": "string",
      "minLength": 1
    },
    "workflow_count": {
      "type": "integer",
      "minimum": 1
    },
    "default_workflow_sequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "focused_skill_mappings": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^skills/.+/SKILL\\.md$"
      }
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "when_to_use",
          "workflow_sequence",
          "focus_areas",
          "required_outputs",
          "validation_rules",
          "common_mistakes"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "when_to_use": {
            "type": "string",
            "minLength": 1
          },
          "workflow_sequence": {
            "$ref": "#/$defs/non_empty_string_array"
          },
          "focus_areas": {
            "$ref": "#/$defs/non_empty_string_array"
          },
          "required_outputs": {
            "$ref": "#/$defs/non_empty_string_array"
          },
          "validation_rules": {
            "$ref": "#/$defs/non_empty_string_array"
          },
          "common_mistakes": {
            "$ref": "#/$defs/non_empty_string_array"
          }
        }
      }
    }
  },
  "$defs": {
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
